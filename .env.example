# Sao chép thành .env rồi sửa nếu cần: cp .env.example .env

# Cổng trên máy host. Mặc định tránh trùng các service phổ biến (5432, 6379, 8000, ...).
API_PORT=8001
POSTGRES_PORT=5433
REDIS_PORT=6380
MAILPIT_UI_PORT=8026
MAILPIT_SMTP_PORT=1026

# Tài khoản PostgreSQL của container
POSTGRES_USER=daily_report
POSTGRES_PASSWORD=daily_report
POSTGRES_DB=daily_report

# Ứng dụng khi chạy trực tiếp trên máy host (make run, make test, alembic).
# Khi chạy bằng Docker, docker-compose.yml tự đặt các giá trị trỏ vào container.
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://daily_report:daily_report@localhost:5433/daily_report
TEST_DATABASE_URL=postgresql+asyncpg://daily_report:daily_report@localhost:5433/daily_report_test
REDIS_URL=redis://localhost:6380/0

# JWT. Production bắt buộc đặt chuỗi ngẫu nhiên riêng, ví dụ: openssl rand -hex 32
JWT_SECRET_KEY=dev-only-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Danh sách origin cho CORS, dạng JSON. Ví dụ: ["http://localhost:3000"]
CORS_ORIGINS=[]
