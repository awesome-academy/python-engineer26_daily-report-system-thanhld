rent="1" source="t_users_id" target="t_report_recipients_recipient_id"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="135"/><mxPoint x="840" y="491"/></Array></mxGeometry></mxCell><mxCell id="rel_6" style="edgeStyle=orthogonalEdgeStyle;fontSize=12;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;rounded=0;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="t_users_id" target="t_user_tokens_user_id"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="135"/><mxPoint x="860" y="671"/></Array></mxGeometry></mxCell><mxCell id="rel_7" style="edgeStyle=orthogonalEdgeStyle;fontSize=12;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;rounded=0;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="t_departments_id" target="t_daily_reports_department_id"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="135"/><mxPoint x="370" y="76"/><mxPoint x="880" y="76"/><mxPoint x="880" y="187"/></Array></mxGeometry></mxCell><mxCell id="rel_8" style="edgeStyle=orthogonalEdgeStyle;fontSize=12;html=1;startArrow=ERmandOne;endArrow=ERoneToMany;startFill=0;endFill=0;rounded=0;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="t_daily_reports_id" target="t_report_recipients_report_id"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="135"/><mxPoint x="1250" y="465"/></Array></mxGeometry></mxCell><mxCell id="notes" value="&lt;b&gt;Index và ràng buộc&lt;/b&gt;&lt;br&gt;users: UNIQUE lower(email) WHERE deleted_at IS NULL&lt;br&gt;users: GIN immutable_unaccent(lower(full_name)) gin_trgm_ops&lt;br&gt;users: INDEX (department_id)&lt;br&gt;departments: UNIQUE lower(code) WHERE deleted_at IS NULL&lt;br&gt;daily_reports: UNIQUE (author_id, report_date)&lt;br&gt;daily_reports: INDEX (department_id, report_date)&lt;br&gt;department_managers: INDEX (user_id)&lt;br&gt;report_recipients: INDEX (recipient_id)&lt;br&gt;refresh_tokens, user_tokens: INDEX (user_id)&lt;br&gt;refresh_tokens: INDEX (session_id)&lt;br&gt;user_tokens: CHECK purpose IN ('SETUP_PASSWORD')&lt;br&gt;email_logs: CHECK status IN ('SENT', 'FAILED')&lt;br&gt;user_role: ENUM ('USER', 'MANAGER', 'ADMIN')&lt;br&gt;&lt;br&gt;&lt;b&gt;ON DELETE&lt;/b&gt;&lt;br&gt;users.department_id: SET NULL&lt;br&gt;department_managers, report_recipients.report_id: CASCADE&lt;br&gt;refresh_tokens, user_tokens: CASCADE&lt;br&gt;daily_reports.author_id, daily_reports.department_id: RESTRICT&lt;br&gt;report_recipients.recipient_id: RESTRICT&lt;br&gt;&lt;br&gt;Xóa mềm: users, departments (deleted_at)&lt;br&gt;email_logs: không có FK, ghi được cả địa chỉ chưa có tài khoản" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1340" y="90" width="440" height="400" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
